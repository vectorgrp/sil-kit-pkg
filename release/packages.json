{
  "comment": [
    "Single source of truth for the Linux packages of SIL Kit.",
    "package-silkit.yml builds every target; sil-kit-delivery publishes the assets of targets with release: true",
    "to the vectorgrp/sil-kit and vectorgrp/sil-kit-pkg releases.",
    "Images are pinned by digest once build-images.yml has published them (see README.rst)."
  ],
  "targets": [
    {
      "id": "ubuntu-20.04-x86_64-deb",
      "runs_on": "ubuntu-latest",
      "image": "ghcr.io/vectorgrp/sil-kit-pkg/ubuntu-2004@sha256:82dec8dab95de332330d614d6f27f39695295bdf2f7164405a2f0d046d108c61",
      "container_options": "",
      "pkgformat": "deb",
      "platform": "Ubuntu-20.04",
      "debuild_args": [
        "-d",
        "--prepend-path=/opt/cmake/bin"
      ],
      "test_image": "ubuntu:20.04",
      "release": true,
      "assets": [
        "libsilkit5_*_amd64.deb",
        "libsilkit-dev_*_amd64.deb",
        "silkit-utils_*_amd64.deb",
        "libsilkit5-dbgsym_*_amd64.ddeb",
        "libsilkit_*_amd64.buildinfo"
      ]
    },
    {
      "id": "ubuntu-20.04-x86_64-tgz",
      "runs_on": "ubuntu-latest",
      "image": "ghcr.io/vectorgrp/sil-kit-pkg/ubuntu-2004@sha256:82dec8dab95de332330d614d6f27f39695295bdf2f7164405a2f0d046d108c61",
      "container_options": "",
      "pkgformat": "tgz",
      "platform": "ubuntu2004",
      "test_image": "ubuntu:20.04",
      "release": true,
      "assets": [
        "libsilkit-*.ubuntu2004.x86_64.tar.gz",
        "libsilkit-*.ubuntu2004.x86_64.debug.tar.gz"
      ]
    },
    {
      "id": "centos-7-x86_64-tgz",
      "runs_on": "ubuntu-latest",
      "image": "ghcr.io/vectorgrp/sil-kit-pkg/centos-7@sha256:726cdaf033a2f97de3fd25a7692fcca4634bc97312d69bb572c5cbb2632648e2",
      "container_options": "",
      "pkgformat": "tgz",
      "platform": "el7",
      "test_image": "centos:7",
      "release": true,
      "assets": [
        "libsilkit-*.el7.x86_64.tar.gz",
        "libsilkit-*.el7.x86_64.debug.tar.gz"
      ]
    },
    {
      "id": "alma-8-x86_64-tgz",
      "runs_on": "ubuntu-latest",
      "image": "ghcr.io/vectorgrp/sil-kit-pkg/alma-8@sha256:c9d7ebdfcab16cc7f514d533f4abfe843abf9cdb4254e7c1c795c3494acb73b1",
      "container_options": "",
      "pkgformat": "tgz",
      "platform": "el8",
      "test_image": "almalinux:8",
      "release": true,
      "assets": [
        "libsilkit-*.el8.x86_64.tar.gz",
        "libsilkit-*.el8.x86_64.debug.tar.gz"
      ]
    },
    {
      "id": "ubuntu-22.04-aarch64-deb",
      "runs_on": "ubuntu-22.04-arm",
      "image": "ghcr.io/vectorgrp/sil-kit-pkg/ubuntu-2204@sha256:7aa2ae3be3e4e578ac556ebe9f0c65a326fac4238f254a72fa0a437cf0771c40",
      "container_options": "",
      "pkgformat": "deb",
      "platform": "Ubuntu-22.04",
      "debuild_args": [
        "-d",
        "--prepend-path=/opt/cmake/bin"
      ],
      "test_image": "ubuntu:22.04",
      "release": false,
      "assets": [
        "libsilkit5_*_arm64.deb",
        "libsilkit-dev_*_arm64.deb",
        "silkit-utils_*_arm64.deb",
        "libsilkit5-dbgsym_*_arm64.ddeb",
        "libsilkit_*_arm64.buildinfo"
      ]
    },
    {
      "id": "alma-9-x86_64-rpm",
      "runs_on": "ubuntu-latest",
      "image": "ghcr.io/vectorgrp/sil-kit-pkg/fedora-40@sha256:c2fd7f079d15ee24958bae12d056915684e1fc335002e05258019fdde88e9dac",
      "container_options": "--privileged",
      "pkgformat": "rpm",
      "platform": "epel9",
      "test_image": "almalinux:9",
      "release": false,
      "assets": [
        "libsilkit5-*.el9.x86_64.rpm",
        "libsilkit5-devel-*.el9.x86_64.rpm",
        "libsilkit5-utils-*.el9.x86_64.rpm",
        "libsilkit5-debuginfo-*.el9.x86_64.rpm"
      ]
    }
  ]
}
